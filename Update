import React, { useEffect, useState } from "react";
import { fetchData, updateData } from "./api";

function UpdateForm({ countryCode }) {
  const [data, setData] = useState([]);
  const [selected, setSelected] = useState(null);
  const [form, setForm] = useState({ id: "", code: "", name: "", displayName: "" });

  useEffect(() => {
    if (countryCode) {
      fetchData(countryCode).then(setData);
    }
  }, [countryCode]);

  const handleSelect = (idOrCode, type) => {
    const found =
      type === "id"
        ? data.find((item) => item.id === idOrCode)
        : data.find((item) => item.code === idOrCode);
    if (found) {
      setSelected(found);
      setForm(found);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    await updateData(form);
    alert("Updated successfully!");
  };

  return (
    <div>
      <h3>Update</h3>
      <div>
        <label>Select by ID:</label>
        <select onChange={(e) => handleSelect(e.target.value, "id")}>
          <option value="">--select--</option>
          {data.map((item) => (
            <option key={item.id} value={item.id}>{item.id}</option>
          ))}
        </select>

        <label>Select by Code:</label>
        <select onChange={(e) => handleSelect(e.target.value, "code")}>
          <option value="">--select--</option>
          {data.map((item) => (
            <option key={item.code} value={item.code}>{item.code}</option>
          ))}
        </select>
      </div>

      {selected && (
        <form onSubmit={handleSubmit}>
          <input value={form.id} readOnly />
          <input value={form.code} readOnly />
          <input
            value={form.name}
            onChange={(e) => setForm({ ...form, name: e.target.value })}
          />
          <input
            value={form.displayName}
            onChange={(e) => setForm({ ...form, displayName: e.target.value })}
          />
          <button type="submit">Update</button>
        </form>
      )}
    </div>
  );
}

export default UpdateForm;
