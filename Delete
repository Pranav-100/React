import React, { useEffect, useState } from "react";
import { fetchData, deleteData } from "./api";

function DeleteForm({ countryCode }) {
  const [data, setData] = useState([]);
  const [selected, setSelected] = useState(null);

  useEffect(() => {
    if (countryCode) {
      fetchData(countryCode).then(setData);
    }
  }, [countryCode]);

  const handleSelect = (idOrCode, type) => {
    const found =
      type === "id"
        ? data.find((item) => item.id === idOrCode)
        : data.find((item) => item.code === idOrCode);
    setSelected(found);
  };

  const handleDelete = async () => {
    if (selected) {
      await deleteData(selected.id);
      alert("Deleted successfully!");
      setSelected(null);
    }
  };

  return (
    <div>
      <h3>Delete</h3>
      <div>
        <label>Select by ID:</label>
        <select onChange={(e) => handleSelect(e.target.value, "id")}>
          <option value="">--select--</option>
          {data.map((item) => (
            <option key={item.id} value={item.id}>{item.id}</option>
          ))}
        </select>

        <label>Select by Code:</label>
        <select onChange={(e) => handleSelect(e.target.value, "code")}>
          <option value="">--select--</option>
          {data.map((item) => (
            <option key={item.code} value={item.code}>{item.code}</option>
          ))}
        </select>
      </div>

      {selected && (
        <div>
          <p>ID: {selected.id}</p>
          <p>Code: {selected.code}</p>
          <p>Name: {selected.name}</p>
          <p>Display Name: {selected.displayName}</p>
          <button onClick={handleDelete}>Delete</button>
        </div>
      )}
    </div>
  );
}

export default DeleteForm;
